        "plt.axhline(0.5, color=\"gray\", linestyle=\"--\", alpha=0.8, label=\"Ngưỡng phân loại (Threshold = 0.5)\")\n",
        "\n",
        "\n",
        "diem_ranh_gioi = -model.intercept_[0] / model.coef_[0][0]\n",
        "plt.axvline(diem_ranh_gioi, color=\"orange\", linestyle=\":\", linewidth=2, label=f\"Ranh giới BMI ≈ {diem_ranh_gioi:.1f}\")\n",
        "\n",
        "plt.title(\"Mô hình Hồi quy Logistic: Dự đoán khả năng mắc bệnh theo BMI\", fontsize=13)\n",
